rules_version = '2';

// =====================================================================
// CAMPUSCONNECT — FIRESTORE SECURITY RULES
// Covers all 10 top-level collections + 3 subcollections defined in
// the Database Design Documentation (Section 6).
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper functions ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == "admin";
    }

    function isRecruiter() {
      return isSignedIn() && (
        getUserRole() == "recruiter" ||
        request.auth.token.email.matches(".*\\+partner@.*") ||
        request.auth.token.email.matches(".*@campusconnect[.]com$")
      );
    }

    // ---- /users/{userId} ----
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- /listings/{listingId} — Marketplace Module ----
    match /listings/{listingId} {
      allow read: if true; // public browsing, per SRS
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // ---- /services/{serviceId} — Services Module ----
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.providerId == request.auth.uid || isAdmin());
    }

    // ---- /jobs/{jobId} — Internship & Jobs Module ----
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isRecruiter();
      allow update, delete: if isSignedIn() &&
        (resource.data.postedBy == request.auth.uid || isAdmin());

      // ---- Subcollection: applications ----
      match /applications/{applicationId} {
        allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
        allow read: if isSignedIn() &&
          (request.auth.uid == resource.data.applicantId ||
           request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.postedBy ||
           isAdmin());
        allow update: if isSignedIn() &&
          (request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.postedBy || isAdmin());
      }
    }

    // ---- /events/{eventId} — Campus Events Module ----
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // ---- Subcollection: rsvps ----
      match /rsvps/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ---- /conversations/{conversationId} — Messaging Module ----
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;

      // ---- Subcollection: messages ----
      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      }
    }

    // ---- /notifications/{notificationId} — Notification Module ----
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() || isAdmin(); // created by Cloud Functions / admin actions
    }

    // ---- /referrals/{referralId} — Referral Module ----
    match /referrals/{referralId} {
      allow read: if isSignedIn() &&
        (resource.data.referrerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    // ---- /ratings/{ratingId} — Ratings & Reviews Module ----
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isAdmin(); // moderation only, per "Moderate Ratings & Reviews"
    }

    // ---- /announcements/{announcementId} — Announcements Module ----
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
